 bool FFmpegVideoDecoder::OnNewFrame(AVFrame* frame) {
+  {
+    steady_clock::time_point now = steady_clock::now();
+    steady_clock::duration duration = now - last_frame_;
+    double seconds = double(duration.count()) * steady_clock::period::num / steady_clock::period::den;
+    LOG(INFO) << "Last frame decoded " << seconds << " seconds ago";
+    last_frame_ = now;
+  }
+
